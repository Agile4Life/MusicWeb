!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build Outputs
/.next/
/out/
/build/
/dist/
.vercel

# Testing & Coverage
/coverage/

# Local Isolated Worktrees
/.worktrees/
/.claude/worktrees/

# TypeScript & Compilers
*.tsbuildinfo
next-env.d.ts

# Environment Variables
.env*
!.env.example

# Scratch & Temporary Debug Scripts
/scratch/
test_smtp.js

