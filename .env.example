# Cấu hình biến môi trường cho Supabase (Điền các giá trị này vào Vercel Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Cấu hình SMTP Email (Dành cho thông báo Passkey & Admin Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
ADMIN_PERSONAL_EMAIL=your_admin_email@gmail.com

# NextAuth Secret
NEXTAUTH_SECRET=your_nextauth_secret_here

# YouTube Data API v3 Key (Tùy chọn — nếu để trống sẽ dùng Invidious miễn phí làm fallback)
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Drive Audio R2 Caching Worker
NEXT_PUBLIC_DRIVE_STREAM_WORKER_URL=https://your-drive-worker.workers.dev
INTERNAL_RESOLVE_SECRET=your_internal_resolve_secret_here

# SoundCloud Stream Cache Worker
NEXT_PUBLIC_SOUNDCLOUD_WORKER_URL=https://your-soundcloud-worker.workers.dev

# YouTube Audio R2 Cache Worker (optional — reduces Vercel Fluid CPU for iOS YouTube audio)
NEXT_PUBLIC_YT_STREAM_WORKER_URL=https://your-yt-stream-worker.workers.dev
INTERNAL_YT_RESOLVE_SECRET=your_yt_resolve_secret_here
